<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:padding="16dp">

    <!--  GLYPH MATRIX PREVIEW  -->
    <com.example.glyphvisualizer.GlyphPreviewView
        android:id="@+id/glyphPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/controlsPanel"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--  BOTTOM CONTROLS PANEL  -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--  Info Texts  -->
        <TextView
            android:id="@+id/patternNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="[PATTERN NAME]"
            android:textAlignment="center"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Knowledge Base: Loading..."
            android:textAlignment="center"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <!--  ТЕЛЕМЕТРИЯ (HUD ДЛЯ РАЗРАБОТКИ)  -->
        <TextView
            android:id="@+id/debugDataText"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="monospace"
            android:gravity="bottom|center_horizontal"
            android:lines="6"
            android:maxLines="6"
            android:minLines="6"
            android:text="[TELEMETRY STANDBY]\n\n\n"
            android:textColor="#00FF00"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/freqStatsText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SUB: 0 | GROWL: 0 | HIGH: 0"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tensionValText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressTension"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00E5FF" />

        <!--  Pattern Controls  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevPattern"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#333333"
                android:text="◀"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnAutoPattern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#00B0FF"
                android:text="AUTO"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNextPattern"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#333333"
                android:text="▶"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!--  Main Toggles  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#E0E0E0"
                android:text="START"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSilentMode"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#555555"
                android:text="SILENT: OFF"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!--  Utility Buttons  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectApps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#222222"
                android:text="APPS"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/btnPickFiles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#222222"
                android:text="FILES"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/btnPickFolder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#222222"
                android:text="FOLDER"
                android:textColor="#00E5FF" />
        </LinearLayout>

        <TextView
            android:id="@+id/trainingProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"
            android:textColor="#00E5FF"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>